datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TRAINEE
  TRAINER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  DROPPED
}

enum ResourceFormat {
  VIDEO
  PPT
  PDF
  DOC
  URL
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AssessmentStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum SentimentTag {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum NotificationType {
  ANNOUNCEMENT
  DEADLINE
  CERTIFICATE
  RISK_ALERT
  SYSTEM
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String
  name            String
  role            Role           @default(TRAINEE)
  approvalStatus  ApprovalStatus @default(APPROVED)
  employeeId      String?        @unique
  department      String?
  organization    String         @default("India Meteorological Department (IMD)")
  designation     String?
  avatarUrl       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  profile          Profile?
  authoredCourses  Course[]            @relation("AuthoredCourses")
  enrollments      Enrollment[]
  resources        LearningResource[]
  questionnaires   Questionnaire[]
  attempts         AssessmentAttempt[]
  feedbacks        Feedback[]          @relation("UserFeedbacks")
  trainerFeedbacks Feedback[]          @relation("TrainerFeedbacks")
  notifications    Notification[]      @relation("UserNotifications")
  achievements     Achievement[]
  competencies     CompetencyMap[]
  certificates     Certificate[]
  auditLogs        AuditLog[]          @relation("UserAuditLogs")
  resourceAccesses ResourceAccessLog[]

  @@index([role, approvalStatus])
  @@index([department])
}

model Profile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualifications     String?
  experienceYears    Int      @default(0)
  bio                String?
  interests          Json     @default("[]")
  skills             Json     @default("[]")
  certificatesEarned Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Course {
  id             String       @id @default(uuid())
  title          String
  code           String       @unique
  description    String
  category       String
  subject        String
  targetAudience String?
  level          CourseLevel  @default(BEGINNER)
  durationHours  Int          @default(10)
  tags           Json         @default("[]")
  thumbnailUrl   String?
  trainerId      String
  trainer        User         @relation("AuthoredCourses", fields: [trainerId], references: [id])
  status         CourseStatus @default(PUBLISHED)
  passingScore   Int          @default(70)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  enrollments    Enrollment[]
  resources      LearningResource[]
  questionnaires Questionnaire[]
  feedbacks      Feedback[]
  certificates   Certificate[]

  @@index([category, level])
  @@index([subject])
  @@index([trainerId])
}

model Enrollment {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status             EnrollmentStatus @default(ENROLLED)
  progressPercentage Int              @default(0)
  atRisk             Boolean          @default(false)
  riskReason         String?
  lastAccessedAt     DateTime         @default(now())
  completedAt        DateTime?
  enrolledAt         DateTime         @default(now())

  certificate        Certificate?

  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([atRisk])
}

model LearningResource {
  id              String         @id @default(uuid())
  title           String
  description     String?
  format          ResourceFormat @default(PDF)
  fileUrl         String
  fileSize        Int?
  durationMinutes Int?
  version         Int            @default(1)
  subject         String
  tags            Json           @default("[]")
  courseId        String?
  course          Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  trainerId       String
  trainer         User           @relation(fields: [trainerId], references: [id])
  isPublic        Boolean        @default(true)
  downloadCount   Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  accessLogs      ResourceAccessLog[]

  @@index([subject])
  @@index([trainerId])
  @@index([format])
}

model ResourceAccessLog {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  accessedAt DateTime         @default(now())

  @@index([userId, accessedAt])
  @@index([resourceId])
}

model Questionnaire {
  id              String           @id @default(uuid())
  title           String
  description     String?
  courseId        String?
  course          Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainerId       String
  trainer         User             @relation(fields: [trainerId], references: [id])
  isAdaptive      Boolean          @default(false)
  deadline        DateTime?
  durationMinutes Int              @default(30)
  passingScore    Int              @default(70)
  status          AssessmentStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  questions       Question[]
  attempts        AssessmentAttempt[]

  @@index([courseId])
  @@index([trainerId])
}

model Question {
  id              String             @id @default(uuid())
  questionnaireId String
  questionnaire   Questionnaire      @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  text            String
  explanation     String?
  difficulty      QuestionDifficulty @default(MEDIUM)
  points          Int                @default(1)
  orderIndex      Int                @default(0)
  tags            Json               @default("[]")
  createdAt       DateTime           @default(now())

  options         Option[]

  @@index([questionnaireId, difficulty])
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  orderIndex Int      @default(0)

  @@index([questionId])
}

model AssessmentAttempt {
  id              String        @id @default(uuid())
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  score           Float         @default(0)
  maxScore        Float         @default(0)
  percentage      Float         @default(0)
  passed          Boolean       @default(false)
  isAdaptive      Boolean       @default(false)
  answers         Json
  startTime       DateTime      @default(now())
  submittedAt     DateTime      @default(now())
  durationSeconds Int           @default(0)
  attemptNumber   Int           @default(1)

  @@index([userId, questionnaireId])
  @@index([passed])
}

model Feedback {
  id             String       @id @default(uuid())
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("UserFeedbacks", fields: [userId], references: [id], onDelete: Cascade)
  trainerId      String
  trainer        User         @relation("TrainerFeedbacks", fields: [trainerId], references: [id])
  rating         Int
  contentRating  Int          @default(5)
  deliveryRating Int          @default(5)
  comments       String
  sentimentTag   SentimentTag @default(NEUTRAL)
  sentimentScore Float        @default(0.0)
  createdAt      DateTime     @default(now())

  @@index([courseId])
  @@index([trainerId])
  @@index([sentimentTag])
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String?
  recipient   User?            @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  targetRole  Role?
  title       String
  message     String
  type        NotificationType @default(ANNOUNCEMENT)
  link        String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([recipientId, isRead])
  @@index([targetRole, createdAt])
}

model Achievement {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeType   String
  title       String
  description String
  iconUrl     String?
  unlockedAt  DateTime @default(now())

  @@index([userId])
}

model CompetencyMap {
  id               String   @id @default(uuid())
  trainerId        String
  trainer          User     @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  subject          String
  proficiencyScore Int      @default(80)
  verified         Boolean  @default(true)
  evidence         String?
  evaluatedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([trainerId, subject])
  @@index([subject, proficiencyScore])
}

model Certificate {
  id                String     @id @default(uuid())
  certificateNumber String     @unique
  enrollmentId      String     @unique
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issueDate         DateTime   @default(now())
  grade             String     @default("Distinction")
  qrCodeDataUrl     String
  pdfUrl            String?
  verificationCode  String     @unique
  isRevoked         Boolean    @default(false)

  @@index([userId])
  @@index([courseId])
  @@index([verificationCode])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation("UserAuditLogs", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
